<!DOCTYPE html>
<html lang="en">
<head><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,700;1,800&display=swap" rel="stylesheet">
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f8f1de">
<title>SHIVAI Dehydrated Food Products | Homemade Taste, Anytime, Anywhere</title>
<!-- SHIVAI storefront build: UPI + COD + Admin PIN change screen (server-validated) -->
<style>
  
.hero-cta .btn.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}


/* Center Explore Products text inside the button */
.hero-cta > a.btn.btn-primary {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  white-space: nowrap;
}

:root{--green:#0f4a2c;--green2:#1f6b40;--lime:#f6eed8;--cream:#fbf6ea;--ink:#16261a;--muted:#64715f;--line:#e8dcc0;--white:#fffdf6;--shadow:0 14px 40px #23431b12}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.announcement{background:var(--green);color:#fffdf6;text-align:center;padding:9px 12px;font-size:12px;letter-spacing:.07em}.header{position:sticky;top:0;z-index:10;background:#fbfcf5ed;backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.nav{max-width:1200px;margin:auto;padding:13px 22px;display:flex;align-items:center;gap:20px}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--green);font-weight:900;letter-spacing:.02em;min-width:220px}.brand span{font-size:19px}.brand small{display:block;color:var(--muted);font-weight:700;font-size:9px;letter-spacing:.13em}.logo{width:58px;height:58px;object-fit:contain;display:block;flex-shrink:0;border-radius:50%;filter:drop-shadow(0 3px 5px #23431b18)}.brand small{display:block;color:var(--muted);font-weight:600;font-size:10px;letter-spacing:.13em}.navlinks{display:flex;align-items:center;gap:22px;margin-left:auto}.navlinks a{color:var(--ink);font-size:13px;font-weight:700;text-decoration:none}.navlinks a:hover{color:var(--green2)}.nav-actions{display:flex;gap:8px}.btn{border:0;border-radius:999px;padding:12px 17px;font-weight:800;font-size:13px;transition:.2s}.btn:hover{transform:translateY(-1px)}.btn-primary{background:var(--green);color:#fffdf6}.btn-light{background:var(--lime);color:var(--green)}.btn-outline{background:transparent;border:1px solid var(--line);color:var(--green)}.cart-count{background:#fffdf6;color:var(--green);border-radius:50%;padding:2px 6px;margin-left:4px}.hero{max-width:1200px;margin:auto;padding:55px 22px 45px;display:grid;grid-template-columns:1.05fr .95fr;gap:35px;align-items:center}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--green2);background:var(--lime);border-radius:999px;padding:8px 13px;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.hero h1{font-size:clamp(42px,5.8vw,76px);line-height:.99;letter-spacing:-.055em;margin:20px 0}.hero h1 em{font-family:'Playfair Display',Georgia,'Times New Roman',serif;font-style:italic;font-weight:800;letter-spacing:-.02em;background:linear-gradient(115deg,#8f6420 0%,#d4a537 45%,#b8862b 70%,#e6c26a 100%);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{max-width:510px;color:var(--muted);font-size:16px;line-height:1.8}.hero-cta{display:flex;gap:10px;flex-wrap:wrap;margin:25px 0}.proof{display:flex;gap:17px;flex-wrap:wrap;color:var(--muted);font-size:12px;font-weight:700}.proof span{display:flex;gap:6px;align-items:center}.hero-art{position:relative;min-height:420px;border-radius:34px;background:radial-gradient(ellipse at 55% 40%,#fffdf6 0,#f8f1de 43%,#dcebc7 100%);overflow:hidden;display:grid;place-items:center}.hero-seal{position:relative;z-index:2;width:min(78%,340px);aspect-ratio:1/1;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:25px;background:radial-gradient(circle at 35% 25%,#176b3b,#06261a 72%);border:9px solid #4eaf35;outline:5px solid #f8f1de;box-shadow:0 18px 35px #23431b30;color:#fffdf6;transform:rotate(-3deg)}.hero-seal:before{content:"✦  ✦  ✦";color:#d4a537;font-size:19px;letter-spacing:8px;order:4;margin-top:12px}.hero-seal .seal-top{font-size:clamp(10px,1.2vw,14px);font-weight:900;letter-spacing:.1em}.hero-seal .seal-leaf{font-size:64px;line-height:1.15;color:#f8f1de}.hero-seal strong{font-size:clamp(28px,3.6vw,45px);line-height:1.05;letter-spacing:-.04em;background:#06261a;border-block:3px solid #b6d52b;padding:9px 0;width:125%;text-shadow:0 2px 1px #0004}.hero-seal .seal-bottom{font-weight:900;color:#d4a537;font-size:clamp(13px,1.5vw,18px);line-height:1.25;margin-top:10px}.hero-food{position:absolute;bottom:15px;left:0;right:0;text-align:center;font-size:30px;letter-spacing:5px;opacity:.95;z-index:1}.hero-food{position:absolute;bottom:14px;left:0;right:0;text-align:center;font-size:43px;letter-spacing:12px;opacity:.9;z-index:1}.hero-art:after{content:"";position:absolute;inset:18px;border:1px solid #ffffffa6;border-radius:25px;pointer-events:none}.sun{position:absolute;width:290px;height:290px;border-radius:50%;background:#f8f1de;top:40px;right:40px}.food-bowl{position:relative;width:260px;height:190px;border-radius:0 0 130px 130px;background:linear-gradient(#f4f0d8,#d6d2ad);border:10px solid #fff9e9;box-shadow:0 30px 35px #344c1e25;display:grid;place-items:center;font-size:95px;transform:rotate(-5deg);z-index:2}.floating{display:none;position:absolute;background:#fffdf6;border:1px solid #ffffffb8;padding:13px 16px;border-radius:17px;box-shadow:var(--shadow);font-size:12px;font-weight:800;z-index:3}.floating b{display:block;color:var(--green);font-size:15px}.f1{left:22px;top:65px}.f2{right:20px;bottom:55px}.leaf{position:absolute;font-size:60px;opacity:.8}.leaf1{left:28px;bottom:50px;transform:rotate(-25deg)}.leaf2{right:48px;top:20px;transform:rotate(25deg)}.strip{background:#f8f1de;border-block:1px solid var(--line)}.strip-inner{max-width:1200px;margin:auto;padding:19px 22px;display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;color:var(--green);font-weight:850;font-size:12px;letter-spacing:.06em}.section{max-width:1200px;margin:auto;padding:65px 22px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:25px}.kicker{color:var(--green2);font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.section h2{font-size:clamp(29px,3.6vw,45px);letter-spacing:-.04em;margin:9px 0}.section-head p{max-width:480px;color:var(--muted);line-height:1.7;margin:0}.categories{display:grid;grid-template-columns:repeat(7,1fr);gap:10px}.cat{background:#fffdf6;border:1px solid var(--line);border-radius:18px;padding:17px 8px;text-align:center;color:var(--ink);font-size:11px;font-weight:800;min-height:105px}.cat .emoji{font-size:29px;display:block;margin-bottom:10px}.cat.active,.cat:hover{background:var(--green);color:#fffdf6;border-color:var(--green)}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}.toolbar input,.toolbar select,.field{border:1px solid var(--line);background:#fffdf6;border-radius:12px;padding:12px 14px;color:var(--ink);outline:none}.toolbar input{flex:1;min-width:180px}.products{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.product{background:#fffdf6;border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:0 4px 20px #23431b05;display:flex;flex-direction:column}.product-visual{height:175px;display:grid;place-items:center;background:linear-gradient(140deg,#f8f1de,#efe3c4);font-size:70px;position:relative}.product-visual .product-image{width:100%;height:100%;object-fit:contain;padding:14px 18px;display:block}.product-visual .tag{position:absolute;top:12px;left:12px;background:#fffdf6;border-radius:999px;padding:6px 9px;font-size:10px;font-weight:900;color:var(--green)}.product-body{padding:17px;display:flex;flex-direction:column;flex:1}.product-body h3{font-size:16px;margin:0 0 8px}.product-body p{font-size:12px;line-height:1.6;color:var(--muted);margin:0 0 13px;flex:1}.product-foot{display:flex;align-items:center;justify-content:space-between;gap:8px}.price{font-weight:900;color:var(--green);font-size:17px}.product-foot button{padding:10px 12px;font-size:11px}.empty{padding:35px;text-align:center;color:var(--muted);grid-column:1/-1}.why{background:var(--green);color:#fffdf6;border-radius:30px;padding:38px;display:grid;grid-template-columns:1fr 1fr;gap:28px}.why h2{font-size:38px;line-height:1.05;margin:10px 0}.why p{color:#efe3c4;line-height:1.8}.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.why-card{padding:17px;border:1px solid #ffffff36;border-radius:17px;background:#ffffff0b}.why-card b{display:block;margin:9px 0}.why-card span{font-size:12px;color:#efe3c4;line-height:1.6}.story{display:grid;grid-template-columns:.85fr 1.15fr;gap:28px;align-items:center}.story-art{background:linear-gradient(145deg,#edf7e5,#fffdf6);border:1px solid var(--line);border-radius:28px;min-height:270px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--green);font-size:clamp(30px,5vw,52px);font-weight:950;letter-spacing:-.04em}.story-art span{font-size:12px;letter-spacing:.12em;text-align:center}.story-copy p{color:var(--muted);line-height:1.85}.story-copy .marathi{font-size:19px;color:var(--green);font-weight:800}.newsletter{background:#f6eed8;border:1px solid var(--line);border-radius:25px;padding:30px;display:flex;align-items:center;justify-content:space-between;gap:20px}.newsletter h3{font-size:24px;margin:0 0 8px}.newsletter p{color:var(--muted);margin:0}.newsletter form{display:flex;gap:8px;min-width:300px}.newsletter input{min-width:0;flex:1}.footer{background:#0c2a1a;color:#fffdf6;padding:40px 22px}.footer-inner{max-width:1200px;margin:auto;display:flex;justify-content:space-between;gap:25px;flex-wrap:wrap}.footer p,.footer a{color:#d6e5d0;font-size:12px;line-height:1.8}.footer a{margin-right:15px;text-decoration:none}.modal-backdrop{position:fixed;inset:0;background:#14231499;z-index:30;display:none;align-items:center;justify-content:center;padding:16px}.modal-backdrop.open{display:flex}.modal{background:var(--cream);border-radius:24px;max-width:620px;width:100%;max-height:90vh;overflow:auto;padding:25px;box-shadow:0 30px 80px #0003}.modal-top{display:flex;justify-content:space-between;align-items:center;gap:12px}.modal-top h2{margin:0}.close{border:0;background:var(--lime);border-radius:50%;width:38px;height:38px;color:var(--green);font-size:20px}.cart-line{display:flex;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid var(--line);padding:14px 0}.qty{display:flex;align-items:center;gap:8px}.qty button{border:1px solid var(--line);background:#fffdf6;border-radius:8px;width:27px;height:27px}.total{display:flex;justify-content:space-between;font-weight:900;font-size:18px;padding:18px 0}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.form-grid label{display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:800}.form-grid .wide{grid-column:1/-1}.hint{font-size:12px;color:var(--muted);line-height:1.6}.notice{padding:12px 14px;background:var(--lime);border-radius:12px;font-size:12px;line-height:1.6;margin:12px 0}.admin-list{font-size:13px}.admin-row{padding:12px 0;border-bottom:1px solid var(--line)}.pill{display:inline-block;background:var(--lime);color:var(--green);padding:5px 8px;border-radius:99px;font-size:10px;font-weight:900}.mobile-menu{display:none}
@media(max-width:900px){.navlinks{gap:12px}.brand{min-width:auto}.nav{gap:10px}.navlinks a{font-size:11px}.nav-actions .btn{padding:10px}.categories{grid-template-columns:repeat(4,1fr)}.products{grid-template-columns:repeat(2,1fr)}.hero{grid-template-columns:1fr;padding-top:35px}.hero-art{min-height:330px}.story{grid-template-columns:1fr}.why{grid-template-columns:1fr}}
@media(max-width:620px){.nav{flex-wrap:wrap;padding:10px 14px}.brand{flex:1}.navlinks{order:3;width:100%;overflow:auto;justify-content:space-between;margin:0;padding:7px 0 2px}.nav-actions .admin-btn{display:none}.nav-actions .btn{padding:9px 11px;font-size:11px}.hero{padding:35px 16px}.hero h1{font-size:47px}.hero-art{min-height:310px}.hero-logo{width:min(76%,290px)}.hero-food{font-size:30px;letter-spacing:4px}.food-bowl{width:205px;height:150px;font-size:72px}.sun{width:220px;height:220px}.f1{left:12px;top:35px}.f2{right:12px;bottom:25px}.section{padding:45px 16px}.section-head{display:block}.categories{grid-template-columns:repeat(2,1fr)}.products{gap:10px}.product-visual{height:130px;font-size:53px}.product-body{padding:12px}.product-body h3{font-size:14px}.product-foot{align-items:flex-start;flex-direction:column}.product-foot button{width:100%}.why{padding:24px}.why-grid{grid-template-columns:1fr 1fr}.newsletter{display:block;padding:22px}.newsletter form{min-width:0;margin-top:18px}.form-grid{grid-template-columns:1fr}.form-grid .wide{grid-column:auto}.strip-inner{justify-content:center}.footer-inner{display:block}}

/* SHIVAI green-and-white visual polish */
:root{--green:#0f4a2c;--green2:#1f6b40;--lime:#f6eed8;--cream:#fffdf6;--ink:#14281c;--muted:#5c7062;--line:#e8dcc0;--white:#fffdf6;--shadow:0 14px 40px #123d2010}
body{background:#fffdf6;color:var(--ink)}
.announcement{background:#0a2e1d;color:#fffdf6}
.header{background:rgba(255,255,255,.96);border-bottom:1px solid #e8dcc0}
.btn-primary{background:#0f4a2c;color:#fffdf6}.btn-primary:hover{background:#0a2e1d}
.btn-light{background:#f6eed8;color:#0f4a2c}
.btn-outline{border-color:#1f6b40;color:#0f4a2c}
.hero{background:#fffdf6}
.hero{grid-template-columns:1fr;text-align:left;justify-items:start}.hero p{max-width:640px}.hero-cta,.proof{justify-content:flex-start}
.hero-art{background:radial-gradient(ellipse at 55% 40%,#fffdf6 0,#f8f1de 48%,#e2f2df 100%);border:1px solid #e1eee0}
.hero-seal{background:radial-gradient(circle at 35% 25%,#19733d,#06261a 72%);border-color:#42a943}
.hero-seal strong{background:#06261a;border-color:#a9d83a}
.eyebrow{background:#f6eed8;color:#0f4a2c;border:1px solid #d3e8d2}
.strip{background:#f8f1de;border-color:#e8dcc0}
.section{background:#fffdf6}
.cat,.product,.modal{background:#fffdf6;border-color:#e8dcc0}
.cat.active,.cat:hover{background:#0f4a2c;border-color:#0f4a2c;color:#fffdf6}
.product-visual{background:linear-gradient(140deg,#fbf7ec,#f6eed8)}
.why{background:#0f4a2c}
.story-art,.newsletter{background:#f8f1de;border-color:#e8dcc0}
.footer{background:#0a2e1d}
.close,.qty button{background:#f6eed8;color:#0f4a2c;border-color:#e8dcc0}
.field,.toolbar input,.toolbar select{background:#fffdf6;border-color:#e8dcc0}
@media(prefers-reduced-motion:no-preference){.product,.cat,.btn{transition:background .2s ease,border-color .2s ease,transform .2s ease,box-shadow .2s ease}.product:hover{box-shadow:0 12px 28px #176b3515;transform:translateY(-2px)}}

.stock-pill{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border:1px solid #dce9dc;border-radius:9px;background:#fbf7ec;color:#42664b;font-weight:750;font-size:11px;letter-spacing:.01em;box-shadow:none}
.stock-ok{background:#f8f1de;border-color:#dcebd9;color:#28683a}
.stock-low{background:#fff8eb;border-color:#f4dfb5;color:#9a5a08}
.stock-out{background:#f4f5f4;border-color:#e3e6e3;color:#777f78;box-shadow:none}
.stock-unknown{background:#f7faf6;border-color:#e2e9e0;color:#627361;box-shadow:none}
.stock-dot{width:7px;height:7px;flex:0 0 7px;border-radius:50%;background:#2f9149;box-shadow:0 0 0 3px #dcefdc;animation:none}
.stock-low .stock-dot{background:#d58b1e;box-shadow:0 0 0 3px #f9e9c9}
.stock-out .stock-dot{background:#8c948d;box-shadow:0 0 0 3px #e6e9e6}
.stock-unknown .stock-dot{display:none}
@media (prefers-reduced-motion:reduce){.stock-dot{animation:none}}

/* Phone OTP checkout additions */
.otp-status{font-size:12px;line-height:1.5;color:var(--muted);margin:5px 0 0}
.otp-status.success{color:#0f4a2c;font-weight:800}
.otp-status.error{color:#a43b2a;font-weight:800}
.otp-box{background:#fbf7ec;border:1px solid #e8dcc0;border-radius:14px;padding:13px}
.otp-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.otp-row .field{flex:1;min-width:120px}
#shivai-recaptcha-container{margin:10px 0;min-height:0}
.verified-mark{display:inline-flex;align-items:center;gap:6px;color:#0f4a2c;font-weight:850;font-size:12px}
@media(max-width:620px){.otp-row button{width:100%}}



/* SHIVAI logo transition integrated from the supplied transition reference.
   All styles are scoped to the overlay to avoid changing store layout. */
.shivai-transition{position:fixed;inset:0;z-index:99999;background:#fbf7ec;display:flex;align-items:center;justify-content:center;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .4s,visibility .4s}
.shivai-transition.on{opacity:1;visibility:visible;pointer-events:all;transition:opacity .15s}
.shivai-transition svg{width:min(82vw,440px);height:auto;overflow:visible}
.shivai-transition svg *{transform-box:fill-box;transform-origin:center}
.shivai-transition .arc{transform-box:view-box;transform-origin:200px 150px}
.shivai-transition.on .ring{animation:shivai-ring .8s cubic-bezier(.2,1.5,.4,1) both}
.shivai-transition.on .fill{animation:shivai-fillin .4s .5s ease-out both}
.shivai-transition.on .rbM{animation:shivai-rbm .5s .65s cubic-bezier(.7,0,.2,1) both}
.shivai-transition.on .rbL{animation:shivai-rbl .5s .75s cubic-bezier(.2,1.4,.4,1) both}
.shivai-transition.on .rbR{animation:shivai-rbr .5s .75s cubic-bezier(.2,1.4,.4,1) both}
.shivai-transition.on .letter{animation:shivai-slam .5s var(--d) cubic-bezier(.2,1.7,.4,1) both}
.shivai-transition.on .l{animation:shivai-spinpop .5s var(--d) cubic-bezier(.2,1.7,.4,1) both}
.shivai-transition.on .arc{animation:shivai-arcspin .7s 1.3s cubic-bezier(.2,1,.3,1) both}
.shivai-transition.on .ch{animation:shivai-up .4s var(--d) both}
.shivai-transition.on .whole{animation:shivai-punch .45s 1.9s cubic-bezier(.2,1.5,.4,1) both}
@keyframes shivai-ring{0%{transform:scale(0) rotate(-200deg);opacity:0}100%{transform:none;opacity:1}}
@keyframes shivai-fillin{from{opacity:0;transform:scale(.6)}to{opacity:1;transform:none}}
@keyframes shivai-rbm{from{clip-path:inset(0 50% 0 50%)}to{clip-path:inset(0 0 0 0)}}
@keyframes shivai-rbl{from{transform:translateX(130px) scaleX(.2);opacity:0}to{transform:none;opacity:1}}
@keyframes shivai-rbr{from{transform:translateX(-130px) scaleX(.2);opacity:0}to{transform:none;opacity:1}}
@keyframes shivai-slam{0%{transform:translate(var(--fx),var(--fy)) scale(2.2) rotate(var(--r));opacity:0;filter:blur(8px)}60%{opacity:1}100%{transform:none;opacity:1;filter:blur(0)}}
@keyframes shivai-spinpop{from{transform:scale(0) rotate(-220deg);opacity:0}to{transform:none;opacity:1}}
@keyframes shivai-arcspin{from{transform:rotate(-100deg);opacity:0}to{transform:none;opacity:1}}
@keyframes shivai-up{from{transform:translateY(20px);opacity:0}to{transform:none;opacity:1}}
@keyframes shivai-punch{0%,100%{transform:scale(1)}40%{transform:scale(1.07)}}
@media(prefers-reduced-motion:reduce){.shivai-transition.on *{animation-duration:.01s!important;animation-delay:0s!important}}



/* Product detail gallery: show the entire uploaded pack photo without cutting off top/bottom. */
.product-detail-photo-stage{height:min(460px,60vh)!important;min-height:220px;overflow:hidden;}
.product-detail-photo-stage #gImg{width:auto!important;height:auto!important;max-width:100%!important;max-height:calc(60vh - 28px)!important;object-fit:contain!important;padding:8px!important;box-sizing:border-box!important;}
@media(max-width:540px){.product-detail-photo-stage{height:min(420px,55vh)!important;min-height:200px;}.product-detail-photo-stage #gImg{max-height:calc(55vh - 24px)!important;}}

/* Marketplace-style product photo frames: consistent square canvas, no overflow or stretching. */
.product-visual{height:auto!important;aspect-ratio:1/1;min-height:0;max-height:none;overflow:hidden;position:relative;background:#fffdf6!important;}
.product-visual .product-image{display:block;width:100%;height:100%;max-width:100%;max-height:100%;min-height:0;object-fit:contain;padding:12px!important;background:#fffdf6;}
.product-visual .product-image.uploaded-product-image{object-fit:cover;padding:0!important;}
.pack-size-chip{display:inline-flex;align-items:center;gap:6px;background:#f8f1de;border:1px solid #d8e8cd;color:#0f4a2c;border-radius:999px;padding:6px 9px;font-size:11px;line-height:1.2;font-weight:850;margin:0 0 12px;}
.product-visual .tag{z-index:2;}
#photoPanel .photo-mode-label{display:block;margin-top:7px;font-size:11px;font-weight:800;color:var(--muted);}
#photoPanel details{border:1px dashed var(--line);border-radius:12px;padding:8px 12px;}
#photoPanel details[open] summary{margin-bottom:8px;}
#photoPanel .admin-row{overflow:hidden;}
#photoPanel .photo-mode-select{width:100%;margin-top:4px;font-size:12px;}
#photoPanel .pending-photo-preview{width:76px;height:76px;flex:0 0 76px;border:1px solid var(--line);border-radius:10px;background:#fffdf6;object-fit:contain;padding:3px;}


/* Clear, prominent payment choice tiles (UPI + COD) */
.payment-picker{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px}
.payment-choice{display:flex;align-items:center;gap:10px;min-width:0;padding:13px 12px;border:2px solid var(--line);border-radius:14px;background:#fffdf6;cursor:pointer;transition:border-color .18s,background .18s,box-shadow .18s}
.payment-choice.selected{border-color:var(--green);background:#f8f1de;box-shadow:0 0 0 2px #176b3515}
.payment-choice input{width:18px;height:18px;accent-color:var(--green);flex:0 0 18px}
.payment-choice-icon{display:grid;place-items:center;flex:0 0 34px;width:34px;height:34px;border-radius:10px;background:#f6eed8;color:var(--green);font-size:20px;font-weight:900}
.payment-choice-copy{display:block;min-width:0}
.payment-choice-copy b{display:block;color:var(--green);font-size:14px;line-height:1.25}
.payment-choice-copy small{display:block;color:var(--muted);font-size:11px;line-height:1.4;font-weight:500;margin-top:3px}
.payment-details-box{padding:13px!important}
@media(max-width:540px){.payment-picker{grid-template-columns:1fr}.payment-choice{padding:12px}}

/* Premium type: serif headings and product names, gold category labels */
h1,h2,h3,.product-body h3,.product-body h3 a,#modalTitle,.modal h3,.modal h2{font-family:'Playfair Display',Georgia,'Times New Roman',serif;color:var(--green);letter-spacing:-.01em}
.product-body h3{font-size:17px;font-weight:700;line-height:1.25}
.product-body h3 a{color:var(--green)!important}
.product-visual .tag{background:#fffdf6;color:#9a6b1f;font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}

/* Card layout to match reference: stock badge on image, category above name */
.card-stock{position:absolute;top:12px;left:12px;z-index:2}
.card-cat{font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#9a6b1f;margin:0 0 6px}
.product-visual .stock-pill{background:#fffdf6}

/* Playfair Display across the whole site */
body,body *{font-family:'Playfair Display',Georgia,'Times New Roman',serif}

/* SHIVAI homepage hero update based on the supplied reference screenshot */
.shivai-hero{max-width:1320px;min-height:560px;padding:58px 28px 42px;display:grid;grid-template-columns:1.02fr .98fr;gap:42px;align-items:center;background:#fbf6ea;text-align:left;justify-items:stretch}
.shivai-hero .hero-copy{min-width:0}
.shivai-hero h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(44px,5.5vw,76px);line-height:1.03;letter-spacing:-.045em;margin:24px 0}
.shivai-hero h1 em{font-style:italic;font-weight:800}
.shivai-hero p{max-width:580px;font-size:19px;line-height:1.6}
.shivai-hero .hero-cta{margin:30px 0 28px}
.shivai-hero .btn-primary{min-height:58px;padding:0 34px;border-radius:999px}
.shivai-hero .proof{gap:10px 12px;font-size:13px}
.shivai-hero .proof span{background:#f6eed8;border-radius:999px;padding:8px 13px;color:#244a32}
.hero-photo-frame{min-width:0;padding:13px;border:1px solid #e7d8b0;border-radius:40px;background:#fbf6ea;box-shadow:0 12px 28px #23431b0b}
.hero-photo{display:block;width:100%;height:clamp(330px,38vw,500px);object-fit:cover;object-position:center;border-radius:30px;box-shadow:0 10px 20px #16351a16}
@media(max-width:850px){.shivai-hero{grid-template-columns:1fr;gap:28px;min-height:0;padding:40px 22px}.shivai-hero h1{font-size:clamp(42px,8vw,62px)}.shivai-hero p{font-size:17px}.hero-photo{height:clamp(280px,58vw,430px)}}
@media(max-width:620px){.shivai-hero{padding:32px 16px}.shivai-hero h1{font-size:44px}.hero-photo-frame{padding:8px;border-radius:27px}.hero-photo{height:280px;border-radius:21px}.shivai-hero .proof{gap:8px}.shivai-hero .proof span{font-size:11px;padding:7px 10px}}


/* HERO IMAGE FIX: embedded image works on both Netlify and Apps Script */
.shivai-hero{display:grid!important;grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr)!important;align-items:center!important;gap:42px!important;text-align:left!important;justify-items:stretch!important;}
.shivai-hero .hero-copy{min-width:0!important;}
.shivai-hero .hero-photo-frame{display:block!important;visibility:visible!important;opacity:1!important;min-width:0!important;width:100%!important;box-sizing:border-box!important;}
.shivai-hero .hero-photo{display:block!important;visibility:visible!important;opacity:1!important;width:100%!important;height:clamp(330px,38vw,500px)!important;object-fit:cover!important;object-position:center!important;}
@media(max-width:850px){.shivai-hero{grid-template-columns:minmax(0,1fr)!important;gap:28px!important}.shivai-hero .hero-photo{height:clamp(280px,58vw,430px)!important}}

/* SHIVAI product heading font fix */
.product-body h3,
.product-body h3 a {
  font-family: "Playfair Display", Georgia, "Times New Roman", serif !important;
  font-size: 17px;
  font-weight: 800 !important;
  line-height: 1.3;
  letter-spacing: -0.02em;
  color: #0f4a2c !important;
}

</style>
</head>
<body>
<div class="announcement">HOMEMADE TASTE, ANYTIME, ANYWHERE · घरगुती चव, कोणत्याही वेळेस!</div>
<header class="header"><nav class="nav">
<a class="brand" href="#home"><img class="logo" src="data:image/png;base64," alt="SHIVAI Dehydrated Food logo"><span>SHIVAI<small>Dehydrated Food Products</small></span></a>
<div class="navlinks"><a href="#home">Home</a><a href="#" onclick="openTrack();return false">Track Order</a><a href="#" onclick="openAdmin();return false">Admin</a></div>
<div class="nav-actions"><button class="btn btn-light" onclick="openCart()">Cart <span class="cart-count" id="cartCount">0</span></button><button class="btn btn-primary admin-btn" onclick="openTrack()">Track</button></div>
</nav></header>
<main id="home">
<section class="hero shivai-hero">
<div class="hero-copy"><span class="eyebrow">✦ Your kitchen, made easier</span><h1>Homemade taste.<br><em>Ready in minutes.</em></h1><p>Discover comforting Indian flavours made convenient. Just add water, cook with love, and bring a little taste of home to every busy day.</p><div class="hero-cta"><a class="btn btn-primary" href="#shop" style="text-decoration:none">Explore Products ↗</a></div><div class="proof"><span>✓ No added food colour*</span><span>✓ Convenient premixes</span><span>✓ Made for busy lives</span></div></div>
<div class="hero-photo-frame"><img class="hero-photo" src="data:image/jpeg;base64," alt="A spread of comforting Indian dishes" loading="eager"></div>
</section>
<div class="strip"><div class="strip-inner"><span>🍃 EASY TO PREPARE</span><span>🥣 COMFORTING FLAVOURS</span><span>⏱️ MADE FOR BUSY DAYS</span><span>💚 A LITTLE TASTE OF HOME</span></div></div>
<section class="section" id="shop"><div class="section-head"><div><span class="kicker">The SHIVAI pantry</span><h2>Find your favourite flavour</h2></div><p>Explore our convenient food range. Choose a category or search for something delicious.</p></div>
<div class="categories" id="categories"></div>
<div class="toolbar"><input id="search" placeholder="Search products…" oninput="renderProducts()"><select id="sort" onchange="renderProducts()"><option value="featured">Sort: Featured</option><option value="low">Price: Low to high</option><option value="high">Price: High to low</option><option value="name">Name: A–Z</option></select></div>
<div class="products" id="products"></div>
<p class="hint">*Product images are taken from the supplied product photos. Prices and stock are awaiting confirmation; verify all product details and label claims before accepting orders.</p>
</section>
<section class="section" id="why"><div class="why"><div><span class="kicker" style="color:#cfe7b8">Why choose SHIVAI</span><h2>Big flavour.<br>Less fuss.</h2><p>Thoughtfully convenient foods inspired by familiar Indian kitchens. Keep a few favourites close for the days when life gets busy and you still want something comforting.</p><button class="btn" style="background:#fffdf6;color:var(--green)" onclick="document.querySelector('#shop').scrollIntoView()">Explore the range ↗</button></div><div class="why-grid"><div class="why-card"><div style="font-size:26px">⏱️</div><b>Quick & convenient</b><span>Easy preparation for busy schedules.</span></div><div class="why-card"><div style="font-size:26px">🏡</div><b>Homestyle inspiration</b><span>Familiar flavours for everyday moments.</span></div><div class="why-card"><div style="font-size:26px">🎒</div><b>Made for your routine</b><span>Useful for students, travellers and workdays.</span></div><div class="why-card"><div style="font-size:26px">🍲</div><b>Plenty to explore</b><span>From soups and breakfasts to curries.</span></div></div></div></section>
<section class="section story" id="story"><div class="story-art" aria-label="SHIVAI Dehydrated Food Products">SHIVAI<span>Dehydrated Food Products</span></div><div class="story-copy"><span class="kicker">A kitchen memory</span><h2>घरगुती चव, कुठेही.</h2><p class="marathi">शिवाईची सुरुवात — घरच्या चवीला सोयीची साथ देण्याच्या कल्पनेतून.</p><p>SHIVAI is built around a simple thought: even when life takes you away from home, a familiar meal can make the day feel warmer. Our range is designed for women balancing many roles, working professionals, students, travellers and people living away from home.</p><button class="btn btn-primary" onclick="openStory()">See the Story ↗</button></div></section>
<section class="section"><div class="newsletter"><div><h3>Join our flavour community</h3><p>Get product updates and kitchen inspiration.</p></div><form onsubmit="subscribe(event)"><input class="field" type="email" id="newsletterEmail" required placeholder="Your email address"><button class="btn btn-primary">Join</button></form></div></section>
</main>
<footer class="footer"><div class="footer-inner"><div><div style="font-size:20px;font-weight:900">SHIVAI Dehydrated Food Products</div><p>Homemade Taste, Anytime, Anywhere.</p></div><div><b>Connect with SHIVAI</b><p>4A/Mauli, New Hind Mill Colony,<br>MHADA, Ghodapdeo, Mumbai – 400033<br>Phone: <a href="tel:+917045745898">+91 70457 45898</a><br>WhatsApp: <a href="https://wa.me/917045745898" target="_blank" rel="noopener noreferrer">+91 70457 45898</a><br>Email:shiavidehydratedfoodproduct@gmail.com</p></div><div><b>Quick links</b><p><a href="#shop">Shop</a><a href="#" onclick="openTrack();return false">Track Order</a><a href="#" onclick="openAdmin();return false">Admin</a></p><p>FSSAI Lic. No. 21524002000704<br>Udyam Registered</p>
<p>© 2026 SHIVAI Dehydrated Food Products. All rights reserved.</p></div></div></footer>

<div class="modal-backdrop" id="modal" onclick="backdropClose(event)"><div class="modal"><div class="modal-top"><h2 id="modalTitle">Your Cart</h2><button class="close" onclick="closeModal()">×</button></div><div id="modalBody"></div></div></div>
<script src="api-bridge.js"></script>
<script src="client.js"></script>




<!-- SHIVAI animated logo overlay -->
<div class="shivai-transition" id="shivai-transition" aria-hidden="true"></div>



<script>
/* Integrated logo-transition module. The store remains a single page; internal
   Home/Shop navigation replays the logo transition before scrolling to its target. */
(function(){
  'use strict';
  var overlay=document.getElementById('shivai-transition');
  if(!overlay) return;
  var busy=false;
  var svg='<svg viewBox="0 0 400 300" role="img" aria-label="SHIVAI Dehydrated Food Products"><defs>'+
    '<linearGradient id="st-gr" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7be08f"/><stop offset=".5" stop-color="#2d7a52"/><stop offset="1" stop-color="#14672b"/></linearGradient>'+
    '<radialGradient id="st-bg" cx=".5" cy=".35" r=".8"><stop offset="0" stop-color="#14502b"/><stop offset="1" stop-color="#072212"/></radialGradient>'+
    '<linearGradient id="st-rb" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0f3a1d"/><stop offset="1" stop-color="#051a0c"/></linearGradient>'+
    '<path id="st-arc-path" d="M 60,152 A 140 98 0 0 1 340,152"/><path id="st-leaf" d="M0,0 C-14,-12 -14,-33 0,-48 C14,-33 14,-12 0,0Z"/></defs>'+
    '<g class="whole"><ellipse class="ring" cx="200" cy="150" rx="168" ry="124" fill="none" stroke="url(#st-gr)" stroke-width="15"/>'+
    '<ellipse class="fill" cx="200" cy="150" rx="159" ry="116" fill="url(#st-bg)"/>'+
    '<ellipse class="fill" cx="200" cy="150" rx="147" ry="105" fill="none" stroke="#fffdf6" stroke-opacity=".28" stroke-width="1.4"/>'+
    '<text class="arc" font-size="12.5" font-weight="900" fill="#fffdf6" letter-spacing="2.6" font-family="Arial Black,Arial,sans-serif"><textPath href="#st-arc-path" startOffset="50%" text-anchor="middle">EAT WELL · LIVE IN HAPPINESS</textPath></text>'+
    '<g transform="translate(200,100)" fill="#fffdf6" stroke="#bfe5c8" stroke-width=".6">'+
    '<use class="l" style="--d:1.2s" href="#st-leaf" transform="rotate(-64)"/><use class="l" style="--d:1.25s" href="#st-leaf" transform="rotate(64)"/>'+
    '<use class="l" style="--d:1.3s" href="#st-leaf" transform="rotate(-34) scale(.8)"/><use class="l" style="--d:1.35s" href="#st-leaf" transform="rotate(34) scale(.8)"/>'+
    '<use class="l" style="--d:1.4s" href="#st-leaf" transform="translate(0,-2) scale(1.1)"/></g>'+
    '<path class="rbL" d="M16,120 L82,120 L82,190 L16,190 L36,155Z" fill="url(#st-rb)" stroke="#fffdf6" stroke-width="2.5" stroke-linejoin="round"/>'+
    '<path class="rbR" d="M384,120 L318,120 L318,190 L384,190 L364,155Z" fill="url(#st-rb)" stroke="#fffdf6" stroke-width="2.5" stroke-linejoin="round"/>'+
    '<g class="rbM" style="transform-box:view-box"><rect x="62" y="116" width="276" height="78" rx="4" fill="url(#st-rb)" stroke="#fffdf6" stroke-width="3"/><rect x="68" y="122" width="264" height="66" rx="2" fill="none" stroke="#2d7a52" stroke-width="1.2"/></g>'+
    '<g id="st-title" font-family="Arial Black,Impact,Arial,sans-serif" font-weight="900" font-size="60" fill="#fffdf6" stroke="#06200f" stroke-width="1.2" paint-order="stroke"></g>'+
    '<g id="st-sub1" font-family="Arial Black,Arial,sans-serif" font-size="14.5" fill="#d4a537"></g><g id="st-sub2" font-family="Arial Black,Arial,sans-serif" font-size="14.5" fill="#d4a537"></g></g></svg>';

  function addLetters(id,str,y,start,step,cls,fromSides){
    var group=overlay.querySelector('#'+id),letters=[],widths=[],total=0;
    for(var i=0;i<str.length;i++){
      var el=document.createElementNS('http://www.w3.org/2000/svg','text');
      el.setAttribute('y',y);el.setAttribute('class',cls);el.textContent=str[i];
      group.appendChild(el);letters.push(el);
    }
    letters.forEach(function(el,i){var width=el.getComputedTextLength();if(str[i]===' ')width=6;widths.push(width);total+=width+1;});
    var x=200-total/2;
    letters.forEach(function(el,i){
      el.setAttribute('x',x);el.style.setProperty('--d',(start+i*step).toFixed(2)+'s');
      if(fromSides){var offsets=[[0,-220],[0,220],[-280,0],[280,0]][i%4];el.style.setProperty('--fx',offsets[0]+'px');el.style.setProperty('--fy',offsets[1]+'px');el.style.setProperty('--r',(i%2?18:-18)+'deg');}
      x+=widths[i]+1;
    });
  }

  function play(callback){
    if(busy){if(typeof callback==='function') callback();return;}
    if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches){if(typeof callback==='function') callback();return;}
    busy=true;
    overlay.classList.remove('on');overlay.innerHTML=svg;overlay.setAttribute('aria-hidden','false');
    addLetters('st-title',"SHIVAI",176,.9,.07,'letter',true);
    addLetters('st-sub1','DEHYDRATED',217,1.6,.03,'ch',false);
    addLetters('st-sub2','FOOD PRODUCTS',236,1.75,.03,'ch',false);
    void overlay.offsetWidth;
    overlay.classList.add('on');
    window.setTimeout(function(){if(typeof callback==='function')callback();},2500);
    window.setTimeout(function(){overlay.classList.remove('on');overlay.setAttribute('aria-hidden','true');busy=false;},2800);
  }

  function scrollToHash(hash){
    var target=document.getElementById(hash.slice(1));
    if(!target){window.location.hash=hash;return;}
    if(window.history&&window.history.replaceState)window.history.replaceState(null,'',hash);
    target.scrollIntoView({behavior:'smooth',block:'start'});
  }

  // Only intercept real same-page Home/Shop links; cart, tracking, admin and checkout stay untouched.
  document.querySelectorAll('a[href="#home"],a[href="#shop"]').forEach(function(link){
    link.addEventListener('click',function(event){
      if(event.defaultPrevented||event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
      event.preventDefault();
      var hash=link.getAttribute('href');
      play(function(){scrollToHash(hash);});
    });
  });

  // Show the animation once on the initial visit/refresh.
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){play();},{once:true});
  else play();
})();
</script>

<script>
// Pull the server-side catalog on every visit so admin updates are shared across devices.
window.addEventListener('load', function(){ setTimeout(function(){ if(window.shivaiAppsScriptCall) syncSharedStoreData(); }, 100); });
</script>
<script>
window.setTimeout(function(){
  if(!window.__SHIVAI_CLIENT_READY__){
    var grid=document.getElementById('products');
    if(grid && !grid.children.length){grid.innerHTML='<div class="empty">The SHIVAI storefront script did not finish loading. Refresh once. If the problem remains, check the Apps Script deployment.</div>';}
  }
}, 7000);
</script>
</body></html>
